<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
   <Appenders>
      <Console name="Console" target="SYSTEM_ERR">
         <PatternLayout pattern="%d{ISO8601} %-5p %c{1}: %m%n"/>
      </Console>
   </Appenders>
   <Loggers>
      <!-- Native authentication debug messages include bearer session identifiers. -->
      <Logger name="com.kingsrook.qqq.backend.core.modules.authentication" level="OFF" additivity="false"/>
      <Logger name="com.kingsrook.qqq.backend.module.rdbms" level="WARN" additivity="false">
         <AppenderRef ref="Console"/>
      </Logger>
      <Root level="WARN"><AppenderRef ref="Console"/></Root>
   </Loggers>
</Configuration>
